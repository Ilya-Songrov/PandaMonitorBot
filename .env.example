# Example environment variables for PandaMonitorBot
# Copy this file to .env and fill in your values

# Deploy root directory (where logs and data will be stored)
DEPLOY_ROOT_DIR=/path/to/deploy/root

# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Comma-separated list of allowed user IDs (get from @userinfobot)
ALLOWED_USER_IDS=123456789,987654321

# Database file path
DATABASE_URL=sqlite:///panda_monitor_bot.db

# Computer name for monitoring
COMPUTER_NAME=MyComputer

# Monitoring interval in seconds
MONITOR_INTERVAL=60

# Logging settings
LOG_LEVEL=INFO
LOG_FILE=panda-monitor-bot.log